  "deliveries/possible": "complete proofs received by hosts other than their producer",
  "messages_signed/unsigned": "Waggle piece or SEACAST chunk messages sent with and without the root signature, all hosts",
  "relation": "SEACAST: mean push-relation size per host at the end of the round",
  "pushes/answers/repairs": "SEACAST chunk messages written as pushes, answers to WANTs, and rebuilt chunks queued as repair, all hosts",
  "chunks_duplicate": "SEACAST chunks received at an index already held, all hosts",
  "cancelled/projected": "SEACAST queued chunks dropped by cancel (card 8) and projection (card 12), all hosts",
  "parks": "SEACAST broken promises: a peer parked for a group (card 5), all hosts"
 },
 "strategies": {
  "announce_pull": "announce and pull, whole proof",
  "gossipsub": "whole proof as one GossipSub message",
  "pieces": "64 pieces on GossipSub; Merkle path and the 2,400-byte root signature in every piece message",
  "waggle": "64 pieces on Waggle; Merkle path in every piece message, root signature only while the peer may lack it",
  "seacast": "SEACAST (cskiraly/seacast-spec v0.12.0, tier 4 setting) on its Waggle binding; 64 data + 64 parity Reed-Solomon chunks, any 64 rebuild the proof; root signature at most once per peer and proof"
